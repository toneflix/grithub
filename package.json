{
    "name": "ghit",
    "type": "module",
    "version": "0.1.22",
    "description": "A CLI tool for managing GitHub repositories, issues, and workflows from your terminal, combining custom workflows with full GitHub API coverage.",
    "main": "bin/cli.mjs",
    "private": false,
    "homepage": "https://ghit.toneflix.net",
    "repository": {
        "url": "https://github.com/toneflix/ghit.git",
        "type": "git"
    },
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "ghit": "bin/cli.mjs"
    },
    "exports": {
        ".": "./bin/cli.mjs"
    },
    "files": [
        "bin",
        "bin/cli.mjs"
    ],
    "keywords": [
        "ghit",
        "cli",
        "command-line",
        "tool",
        "integration",
        "sdk",
        "api",
        "developer",
        "h3ravel",
        "toneflix"
    ],
    "scripts": {
        "quick:test": "pnpm vitest --run",
        "test": "pnpm run quick:test",
        "lint": "eslint . --ext .ts --ext .js",
        "cmd": "tsx --experimental-specifier-resolution=node src/cli.ts",
        "build": "tsdown",
        "dummy": "node ./tests/test.sever.js",
        "version": "pnpm run build",
        "unlink": "pnpm uninstall --global ghit",
        "release": "pnpm changeset version && pnpm changeset publish",
        "publish-it": "pnpm publish --tag latest",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "preuninstall": "node ./uninstall.js",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@antfu/install-pkg": "^1.1.0",
        "@h3ravel/musket": "^0.10.1",
        "@h3ravel/shared": "^0.30.3",
        "@ngrok/ngrok": "^1.7.0",
        "@octokit/oauth-methods": "^6.0.2",
        "@octokit/openapi": "^22.0.0",
        "@octokit/rest": "^22.0.1",
        "axios": "^1.13.5",
        "better-sqlite3": "^12.6.2",
        "cli-table3": "^0.6.5",
        "dotenv": "^17.2.3",
        "fast-diff": "^1.3.0",
        "open": "^11.0.0",
        "tsdown": "^0.20.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.5",
        "@eslint/js": "^9.39.2",
        "@eslint/markdown": "^7.5.1",
        "@octokit/openapi-types": "^27.0.0",
        "@swc/core": "^1.6.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.14.5",
        "eslint": "^9.39.2",
        "sass-embedded": "^1.90.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.3",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.53.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitepress": "^1.5.0",
        "vitest": "^3.2.4",
        "vue": "^3.5.13"
    }
}